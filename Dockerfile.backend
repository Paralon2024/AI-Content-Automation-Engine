# ── Stage 1: Build whisper.cpp ─────────────────────────────────────────────────
FROM debian:bookworm-slim AS whisper-builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    git cmake build-essential ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN git clone --depth 1 https://github.com/ggerganov/whisper.cpp /tmp/whisper && \
    cmake -S /tmp/whisper -B /tmp/whisper/build \
          -DCMAKE_BUILD_TYPE=Release \
          -DGGML_NATIVE=OFF \
          -DBUILD_SHARED_LIBS=OFF && \
    cmake --build /tmp/whisper/build --config Release -j"$(nproc)"

# ── Stage 2: Runtime ──────────────────────────────────────────────────────────
FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=whisper-builder /tmp/whisper/build/bin/whisper-cli /usr/local/bin/whisper-cli

ENV WHISPER_MODEL_PATH=/opt/whisper/ggml-small.bin

ENV POETRY_VERSION=1.8.3 \
    POETRY_VIRTUALENVS_CREATE=false \
    POETRY_NO_INTERACTION=1 \
    PYTHONUNBUFFERED=1

RUN pip install --no-cache-dir "poetry==${POETRY_VERSION}"

WORKDIR /app

COPY pyproject.toml poetry.lock* ./
RUN poetry install --no-root --only main

COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
# Normalize Windows line endings and ensure a portable, executable entrypoint.
RUN sed -i 's/\r$//' /usr/local/bin/docker-entrypoint.sh && \
    chmod 755 /usr/local/bin/docker-entrypoint.sh

ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
CMD ["uvicorn", "api.server:app", "--host", "0.0.0.0", "--port", "8000"]
